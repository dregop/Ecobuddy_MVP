{
  "cli": {
    "version": ">= 16.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "API_URL": "http://127.0.0.1:3001"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "API_URL": "https://ecobuddy-mvp-back.onrender.com"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true,
      "env": {
        "API_URL": "https://ecobuddy-mvp-back.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
